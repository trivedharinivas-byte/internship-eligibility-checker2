# ========================================================
# Backend Environment Configuration Template
# ========================================================

# Server Port (auto-assigned on PaaS like Render/Railway/Heroku via $PORT)
PORT=8080

# Active Profile: 'default' (Embedded H2) or 'prod' (MySQL)
SPRING_PROFILES_ACTIVE=prod

# Database Connection (when SPRING_PROFILES_ACTIVE=prod)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/internship_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# Hibernate DDL: 'update' (auto update tables) or 'validate'
JPA_DDL_AUTO=update
